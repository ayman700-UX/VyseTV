# vyse_usenet_unpack(<target> <file in the archive> <out variable>)
#
# Unpacks binaries/vyse-usenet-<target>.zip into the build folder, after checking the archive
# against binaries/manifest.json, and sets <out variable> to the unpacked file's path.
function(vyse_usenet_unpack TARGET FILE_NAME OUT_VAR)
  set(BINARIES "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../binaries")
  set(ARCHIVE "${BINARIES}/vyse-usenet-${TARGET}.zip")
  if(NOT EXISTS "${ARCHIVE}")
    message(FATAL_ERROR "The Usenet engine for ${TARGET} is missing: ${ARCHIVE}")
  endif()
  file(READ "${BINARIES}/manifest.json" MANIFEST)
  string(JSON WANT GET "${MANIFEST}" sha256 "vyse-usenet-${TARGET}.zip")
  file(SHA256 "${ARCHIVE}" GOT)
  if(NOT GOT STREQUAL WANT)
    message(FATAL_ERROR "vyse-usenet-${TARGET}.zip is not the build manifest.json names (sha256 ${GOT})")
  endif()
  set(DIR "${CMAKE_CURRENT_BINARY_DIR}/vyse_usenet_engine")
  file(MAKE_DIRECTORY "${DIR}")
  file(ARCHIVE_EXTRACT INPUT "${ARCHIVE}" DESTINATION "${DIR}")
  if(NOT EXISTS "${DIR}/${FILE_NAME}")
    message(FATAL_ERROR "vyse-usenet-${TARGET}.zip holds no ${FILE_NAME}")
  endif()
  set(${OUT_VAR} "${DIR}/${FILE_NAME}" PARENT_SCOPE)
endfunction()
